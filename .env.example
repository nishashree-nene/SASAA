# ============================================================
# SASAA – .env.example
# Copy this file to .env and fill in your actual values.
# Never commit .env to Git.
# ============================================================

DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/sasaa_db
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/sasaa_db

SECRET_KEY=generate-with--python-c-"import-secrets;print(secrets.token_hex(32))"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

GNANI_API_KEY=your-gnani-api-key-here
GNANI_STT_URL=your-gnani-api-key-here
GNANI_TIMEOUT_SECONDS=120
GNANI_MAX_RETRIES=3

APP_NAME=SASAA
APP_VERSION=1.0.0
ENVIRONMENT=development
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

AUDIO_STORAGE_PATH=./audio_storage
MAX_AUDIO_SIZE_MB=50

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@sasaa.app

FIREBASE_CREDENTIALS_PATH=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=admin@sasaa.app

LOG_LEVEL=INFO

# ── Telephony (Exotel India) ─────────────────────────────────────────────────
# Required for live missed-call voicemail using Exotel.
# Leave empty to use the mock provider for local development and testing.
# Create an account at https://exotel.com and get credentials from
# Dashboard → Settings → API Settings.
TELEPHONY_PROVIDER=mock

EXOTEL_ACCOUNT_SID=your-exotel-account-sid
EXOTEL_API_KEY=your-exotel-api-key
EXOTEL_API_TOKEN=your-exotel-api-token
EXOTEL_PHONE_NUMBER=+91XXXXXXXXXX
EXOTEL_WEBHOOK_SECRET=optional-shared-secret-for-webhook-validation
EXOTEL_SUBDOMAIN=api.in.exotel.com

MAX_VOICEMAIL_DURATION_SECONDS=120
VOICEMAIL_GREETING=Hello, you have reached SASAA voicemail. This call will be recorded and transcribed. Please leave your message after the tone.
